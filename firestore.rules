rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles: each user can only read and write their own private document
    match /users/{userId} {
      // Private profile: only the document owner can read their private data
      allow read: if request.auth != null && request.auth.uid == userId;

      // Creation: must be authenticated, match UID, and have valid customer or worker role
      allow create: if request.auth != null 
                    && request.auth.uid == userId 
                    && request.resource.data.uid == userId 
                    && request.resource.data.role in ['customer', 'worker'];

      // Update: only document owner, and protected fields (uid, role) are strictly immutable
      allow update: if request.auth != null 
                    && request.auth.uid == userId 
                    && request.resource.data.uid == resource.data.uid 
                    && request.resource.data.role == resource.data.role;

      // Deletion: denied from client
      allow delete: if false;
    }

    // Worker profiles: public read for marketplace discovery, write only by worker owner
    match /workers/{workerId} {
      allow read: if true;
      allow create: if request.auth != null 
                    && request.auth.uid == workerId 
                    && request.resource.data.workerId == workerId;
      allow update: if request.auth != null 
                    && request.auth.uid == workerId 
                    && request.resource.data.workerId == resource.data.workerId;
      allow delete: if false;
    }

    // Job listings: public read for job seekers, create/update/delete by job creator
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.customerId == request.auth.uid;
    }

    // Job Applications: only applicant worker or job customer can read/write
    match /applications/{applicationId} {
      allow read: if request.auth != null && (
        resource.data.workerId == request.auth.uid ||
        resource.data.customerId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.workerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.workerId == request.auth.uid ||
        resource.data.customerId == request.auth.uid
      );
      allow delete: if request.auth != null && resource.data.workerId == request.auth.uid;
    }

    // Bookings: only participating customer or worker can read/write
    match /bookings/{bookingId} {
      allow read: if request.auth != null && (
        resource.data.customerId == request.auth.uid ||
        resource.data.workerId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.customerId == request.auth.uid ||
        resource.data.workerId == request.auth.uid
      );
      allow delete: if false;
    }
  }
}
