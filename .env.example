# =============================================================================
# MY VELAI - Environment Variables Template
# =============================================================================
# Copy this file to `.env` in the project root:
#   cp .env.example .env
#
# Obtain these values from your Firebase Console:
#   Firebase Console -> Project Settings -> General -> Your apps -> Web app
#
# IMPORTANT:
# - Variables starting with `EXPO_PUBLIC_` are bundled into the client app.
# - NEVER put service-account private keys, admin secrets, or database master
#   passwords in this file or anywhere in the client code.
# =============================================================================

EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id
